generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

// Resto del esquema igual...
model Couple {
  id          String    @id @default(cuid())
  code        String    @unique
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  users       User[]
  invitations CoupleInvitation[]
  
  @@map("couples")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  displayName   String?   @map("display_name")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  coupleId      String?   @map("couple_id")
  couple        Couple?   @relation(fields: [coupleId], references: [id])
  
  sentInvitations CoupleInvitation[] @relation("InviterUser")
  
  @@map("users")
}

model CoupleInvitation {
  id          String    @id @default(cuid())
  code        String
  inviterId   String    @map("inviter_id")
  used        Boolean   @default(false)
  usedBy      String?   @map("used_by")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  
  inviter     User      @relation("InviterUser", fields: [inviterId], references: [id])
  couple      Couple    @relation(fields: [code], references: [code])
  
  @@unique([code, inviterId])
  @@map("couple_invitations")
}